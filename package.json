{
  "name": "proofmeta-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Generic ProofMeta MCP server — fail-closed manifest discovery and verification via @proofmeta/sdk-ts. No payment, storage, chain, or registry.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "proofmeta-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node examples/smoke/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@proofmeta/sdk-ts": "file:vendor/proofmeta-sdk-ts-0.5.0.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@noble/ed25519": "2.3.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.7.3"
  },
  "keywords": [
    "proofmeta",
    "mcp",
    "model-context-protocol",
    "manifest",
    "verification",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  }
}
